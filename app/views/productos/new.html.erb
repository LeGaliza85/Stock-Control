<div class="w-full max-w-2xl mx-auto px-2 sm:px-0">
  <div class="mb-6">
    <%= link_to productos_path, class: "inline-flex items-center gap-1 text-[#B8860B] hover:text-[#9A7209] text-sm font-medium transition-all duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
      Volver al inventario
    <% end %>
  </div>
  <h1 class="text-2xl sm:text-3xl font-bold text-[#2C1810] mb-6 sm:mb-8">Nuevo Producto</h1>
  <%= render "form", edit_mode: false %>
</div>

<% if @quick_analyze %>
<script>
document.addEventListener('DOMContentLoaded', function() {
  // Esperar un poco para que la página cargue completamente
  setTimeout(function() {
    var btnAnalizar = document.getElementById('btnAnalizarIA');
    if (btnAnalizar) {
      btnAnalizar.click();
    }
  }, 500);
});
</script>
<% end %>

<script>
function initIAImage() {
  var params = new URLSearchParams(window.location.search);
  var iaImageKey = params.get('ia_image_key');
  var fromIa = params.get('from_ia');
  
  if (iaImageKey && fromIa) {
    var imageSrc = sessionStorage.getItem(iaImageKey);
    console.log('Imagen recuperada de sessionStorage:', iaImageKey, 'tamaño:', imageSrc ? imageSrc.length : 0);
    sessionStorage.removeItem(iaImageKey);
    
    if (imageSrc) {
      // Guardar en variable global para usar en submit
      window.iaImageDataGlobal = imageSrc;
      
      function agregarInput() {
        var form = document.querySelector('form');
        if (form) {
          if (form.querySelector('input[name="producto[ia_image_data]"]')) {
            console.log('Input ya existe');
            return true;
          }
          
          var previewContainer = document.querySelector('[data-photo-preview-target="preview"]');
          if (previewContainer) {
            var imgDiv = document.createElement('div');
            imgDiv.className = 'relative inline-block ia-preview';
            imgDiv.innerHTML = '<img src="' + imageSrc + '" class="w-20 h-20 object-cover rounded-lg border-2 border-[#7C3AED]">';
            imgDiv.innerHTML += '<div class="absolute -top-1 -right-1 bg-[#7C3AED] text-white text-xs px-1.5 py-0.5 rounded">IA</div>';
            previewContainer.appendChild(imgDiv);
          }
          
          var hiddenInput = document.createElement('input');
          hiddenInput.type = 'hidden';
          hiddenInput.name = 'producto[ia_image_data]';
          hiddenInput.value = imageSrc;
          form.appendChild(hiddenInput);
          console.log('Input hidden creado con imagen de tamaño:', imageSrc.length);
          return true;
        }
        return false;
      }
      
      if (!agregarInput()) {
        setTimeout(agregarInput, 100);
      }
    }
    
    var cleanUrl = window.location.pathname;
    window.history.replaceState({}, document.title, cleanUrl);
  }
}

document.addEventListener('turbo:load', initIAImage);
document.addEventListener('DOMContentLoaded', initIAImage);

// También intentar en el submit del formulario
document.addEventListener('submit', function(e) {
  var form = e.target;
  if (form && window.iaImageDataGlobal) {
    if (!form.querySelector('input[name="producto[ia_image_data]"]')) {
      var hiddenInput = document.createElement('input');
      hiddenInput.type = 'hidden';
      hiddenInput.name = 'producto[ia_image_data]';
      hiddenInput.value = window.iaImageDataGlobal;
      form.appendChild(hiddenInput);
      console.log('Input agregado en submit:', window.iaImageDataGlobal.length);
    }
  }
});
</script>
