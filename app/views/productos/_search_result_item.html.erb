<%# locals: (producto:, similitud: nil) %>
<%= link_to producto_path(producto), class: "flex items-center gap-3 p-3 rounded-lg border border-[#E8E0D4] hover:bg-[#FAF7F2] transition-colors" do %>
  <% if producto.fotos.attached? %>
    <%= image_tag producto.fotos.first.variant(resize_to_limit: [64, 64]), class: "w-16 h-16 object-cover rounded-lg" %>
  <% else %>
    <div class="w-16 h-16 bg-[#FAF7F2] rounded-lg flex items-center justify-center border border-[#E8E0D4]">
      <svg class="w-6 h-6 text-[#E8E0D4]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
  <% end %>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2 mb-1">
      <%= render "productos/etiqueta_badge", etiqueta: producto.etiqueta, full_width: false %>
      <% if similitud %>
        <span class="text-xs font-bold text-white px-2 py-0.5 rounded bg-blue-600"><%= similitud %>%</span>
      <% end %>
    </div>
    <p class="font-medium text-[#2C1810] truncate"><%= producto.nombre.presence || "Sin nombre" %></p>
    <p class="text-sm text-[#B8860B] font-semibold"><%= formato_precio(producto.precio_venta) %></p>
  </div>
<% end %>
