<div data-controller="quick-category product-search">
  <%= form_with model: @producto, multipart: true, local: true, class: "bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-8" do |f| %>
    <% edit_mode = local_assigns[:edit_mode] || false %>
    <input type="hidden" id="formEditMode" value="<%= edit_mode %>">
    <% if @producto.errors.any? %>
      <div class="bg-[#F4DCDC] border border-[#A63D2F]/30 rounded-lg p-4 mb-8">
        <h3 class="text-[#A63D2F] font-semibold mb-2">Se encontraron <%= pluralize(@producto.errors.count, "error") %>:</h3>
        <ul class="list-disc list-inside text-[#A63D2F]/80 text-sm">
          <% @producto.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Código del producto -->
    <% if @producto.codigo.present? %>
      <div class="mb-6 p-3 bg-[#F5ECD7] rounded-lg border border-[#E8E0D4]">
        <div class="flex items-center gap-2">
          <span class="text-sm text-[#9C8B7A]">Código del producto:</span>
          <span class="text-sm font-bold text-[#2C1810]"><%= formato_codigo(@producto.codigo) %></span>
        </div>
      </div>
    <% end %>

    <!-- Información básica -->
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-[#2C1810] mb-4" style="font-family: 'Playfair Display', serif;">Información básica</h2>
      <div class="space-y-5">
        <div>
          <%= f.label :nombre, class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.text_field :nombre, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base truncate" %>
        </div>
        <div>
          <%= f.label :descripcion, class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.text_area :descripcion, rows: 4, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        </div>
      </div>
    </div>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Precios -->
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-[#2C1810] mb-4" style="font-family: 'Playfair Display', serif;">Precios</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :precio_compra, class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.number_field :precio_compra, step: 0.01, min: 0, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        </div>
        <div>
          <%= f.label :precio_venta, class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.number_field :precio_venta, step: 0.01, min: 0, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        </div>
      </div>
    </div>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Detalles -->
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-[#2C1810] mb-4" style="font-family: 'Playfair Display', serif;">Detalles</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <%= f.label :estado, class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.select :estado, Producto.estados.keys.map { |e| [e.humanize, e] }, { prompt: "Seleccionar estado" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        </div>
        <div>
          <%= f.label :categoria_id, "Categoría", class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.select :categoria_id, Categoria.order(:nombre).pluck(:nombre, :id), { prompt: "Seleccionar categoría" }, { data: { quick_category_target: "select" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" } %>
          <p class="mt-1.5 text-xs text-[#9C8B7A]">
            ¿No encuentras la categoría? <button type="button" data-action="click->quick-category#open" class="text-[#B8860B] hover:text-[#9A7209] underline cursor-pointer">Crear nueva</button>
          </p>
        </div>
        <div>
          <%= f.label :etiqueta, "Etiqueta", class: "block text-sm font-medium text-[#6B5744] mb-1.5" %>
          <%= f.select :etiqueta, Producto.etiquetas.keys.map { |e| [e.humanize, e] }, { prompt: "Seleccionar etiqueta" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        </div>
      </div>
    </div>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Fotografías -->
    <div class="mb-8" data-controller="photo-preview">
      <h2 class="text-lg font-semibold text-[#2C1810] mb-4" style="font-family: 'Playfair Display', serif;">Fotografías</h2>
      <div class="flex flex-wrap gap-3 mb-3">
        <button type="button" data-action="click->photo-preview#openCamera"
          class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold text-white cursor-pointer transition-all duration-200" style="background-color: #B8860B;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Tomar foto
        </button>
        <div id="cameraInputContainer" class="hidden">
          <input type="file" id="cameraInput" name="producto[fotos][]" accept="image/*" capture="environment" multiple data-action="change->photo-preview#preview">
        </div>
        <button type="button" data-action="click->photo-preview#openGallery"
        class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold cursor-pointer transition-all duration-200 border border-[#E8E0D4] text-[#6B5744] hover:bg-[#F5ECD7]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Galería
        </button>
        <input type="file" id="fotosInput" name="producto[fotos][]" accept="image/*" multiple class="hidden" data-action="change->photo-preview#preview">
        
        <button type="button" data-action="click->product-search#openIaModal"
          class="inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-semibold cursor-pointer transition-all duration-200 border-2 border-[#7C3AED] text-[#7C3AED] hover:bg-[#7C3AED] hover:text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
          Analizar con IA
        </button>
        <input type="file" data-product-search-target="iaFileInput" data-action="change->product-search#onIaFileChange" accept="image/*" capture="environment" class="hidden">
      </div>

      <div data-photo-preview-target="preview" class="mt-3 flex flex-wrap gap-3 min-h-[20px]"></div>
      <p data-photo-preview-target="counter" class="hidden mt-2 text-xs font-medium text-[#B8860B]"></p>

      <% if @producto.fotos.attached? %>
        <div class="mt-3">
          <p class="text-xs font-medium text-[#6B5744] mb-2">Fotos actuales (<%= @producto.fotos.count %>) - Haz clic en la X para eliminar:</p>
          <div class="flex flex-wrap gap-2">
            <% @producto.fotos.each do |foto| %>
              <div class="relative foto-item group" data-foto-id="<%= foto.id %>">
                <%= image_tag foto.variant(resize_to_limit: [100, 100]), class: "rounded-lg border-2 border-[#E8E0D4] foto-preview" %>
                <button type="button" data-action="click->photo-preview#eliminarFotoExistente" data-foto-id='<%= foto.id %>'
                  class="absolute -top-2 -right-2 w-6 h-6 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors shadow-md btn-eliminar">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
                <button type="button" data-action="click->photo-preview#cancelarEliminarFotoExistente" data-foto-id='<%= foto.id %>'
                  class="hidden absolute -top-2 -right-2 w-6 h-6 bg-green-500 text-white rounded-full flex items-center justify-center hover:bg-green-600 transition-colors shadow-md btn-cancelar">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                </button>
                <div class="hidden absolute inset-0 rounded-lg bg-red-500/20 border-2 border-red-500 pointer-events-none foto-marcada"></div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <input type="hidden" name="producto[fotos_a_eliminar]" data-photo-preview-target="fotosAEliminar" value="">
    </div>

    <div>
      <%= f.submit "Guardar", class: "w-full rounded-lg bg-[#B8860B] px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] cursor-pointer transition-all duration-200" %>
    </div>
  <% end %>

  <!-- Modal nueva categoría -->
  <div data-quick-category-target="modal" class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4" style="background: rgba(28, 24, 20, 0.85);">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full p-6">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-bold text-[#2C1810]">Nueva Categoría</h3>
        <button type="button" data-action="click->quick-category#close" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      <form data-action="submit->quick-category#submit">
        <div class="mb-4">
          <label class="block text-sm font-medium text-[#6B5744] mb-1.5">Nombre</label>
          <input type="text" data-quick-category-target="input" class="w-full rounded-lg border border-[#E8E0D4] p-2.5" required>
        </div>
        <div data-quick-category-target="error" class="hidden mb-4 p-2 bg-red-50 text-red-600 text-sm rounded"></div>
        <div class="flex gap-3">
          <button type="submit" class="flex-1 bg-[#B8860B] text-white py-2 rounded-lg font-semibold hover:bg-[#9A7209]">Crear</button>
          <button type="button" data-action="click->quick-category#close" class="flex-1 border border-[#E8E0D4] py-2 rounded-lg">Cancelar</button>
        </div>
      </form>
    </div>
  </div>

  <%= render "shared/ia_modal", show_fill_form: !edit_mode %>
</div>
