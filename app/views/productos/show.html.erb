<div class="w-full max-w-4xl mx-auto" data-controller="lightbox">
  <% content_for :breadcrumbs do %>
    <%= render 'shared/breadcrumbs', paths: [
      { name: "Inventario", url: productos_path },
      { name: @producto.nombre, url: nil }
    ] %>
  <% end %>

  <% if @producto.fotos.attached? %>
    <div class="mb-8" id="gallery" data-controller="gallery">
      <% fotos = @producto.fotos.to_a %>

      <%# Imagen principal (clickable para zoom) %>
      <div class="relative rounded-xl overflow-hidden shadow-md bg-[#FAF7F2] aspect-[4/3]">
        <% fotos.each_with_index do |foto, i| %>
          <%= image_tag foto.variant(resize_to_limit: [800, 600]), 
              class: "w-full h-full object-cover absolute inset-0 transition-opacity duration-300 cursor-zoom-in", 
              style: (i == 0 ? "opacity:1" : "opacity:0"), 
              data: { 
                gallery_target: "slide", 
                action: "click->lightbox#open",
                zoom_url: url_for(foto) 
              } %>
        <% end %>
        <%
          etiqueta_colors = {
            "en_venta" => "bg-gradient-to-r from-green-500 to-emerald-500",
            "reservado" => "bg-gradient-to-r from-amber-500 to-orange-500",
            "vendido" => "bg-gradient-to-r from-red-500 to-rose-500",
            "en_restauracion" => "bg-gradient-to-r from-violet-500 to-purple-500"
          }
          etiqueta_textos = {
            "en_venta" => "EN VENTA",
            "reservado" => "RESERVADO",
            "vendido" => "VENDIDO",
            "en_restauracion" => "EN RESTAURACIÓN"
          }
        %>
        <div class="absolute top-0 left-0 w-full <%= etiqueta_colors[@producto.etiqueta] %> text-white text-xs font-bold text-center py-1">
          <%= etiqueta_textos[@producto.etiqueta] %>
        </div>

        <% if fotos.size > 1 %>
          <button type="button" data-action="click->gallery#prev" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 backdrop-blur flex items-center justify-center cursor-pointer hover:bg-white transition shadow-md">
            <svg class="w-5 h-5 text-[#2C1810]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" data-action="click->gallery#next" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 backdrop-blur flex items-center justify-center cursor-pointer hover:bg-white transition shadow-md">
            <svg class="w-5 h-5 text-[#2C1810]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="absolute bottom-3 right-3 bg-black/50 text-white text-xs px-2 py-1 rounded-full" data-gallery-target="counter">1 / <%= fotos.size %></div>
        <% end %>
      </div>

      <%# Miniaturas %>
      <% if fotos.size > 1 %>
        <div class="flex gap-2 mt-3 overflow-x-auto pb-1" id="galThumbs">
          <% fotos.each_with_index do |foto, i| %>
            <button type="button" 
                data-index="<%= i %>" 
                data-gallery-target="thumb" 
                data-zoom-url="<%= url_for(foto) %>"
                data-action="click->gallery#goto click->lightbox#open" 
                class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 cursor-pointer transition-all <%= i == 0 ? 'border-[#B8860B]' : 'border-transparent opacity-70 hover:opacity-100' %>">
              <%= image_tag foto.variant(resize_to_limit: [100, 100]), class: "w-full h-full object-cover" %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-8">
    <!-- Header -->
    <div class="flex justify-between items-start mb-2">
      <h1 class="text-3xl font-bold text-[#2C1810] wrap-break-word"><%= @producto.nombre %></h1>
      <%
        badge_colors = {
          "nuevo" => "bg-[#E8F0E8] text-[#3D5E3D]",
          "bueno" => "bg-[#E4ECF4] text-[#3D5470]",
          "aceptable" => "bg-[#F5ECD7] text-[#8B6914]",
          "desgastado" => "bg-[#F4E4DC] text-[#8B4F3A]",
          "restauracion" => "bg-[#F4DCDC] text-[#7F3333]"
        }
      %>
      <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium <%= badge_colors[@producto.estado] %>">
        <%= @producto.estado.humanize %>
      </span>
    </div>

    <!-- Código del producto -->
    <% if @producto.codigo.present? %>
      <div class="flex items-center gap-2 mb-6">
        <span class="text-sm text-[#9C8B7A]">Código:</span>
        <span class="text-sm font-bold text-[#2C1810] bg-[#F5ECD7] px-2 py-0.5 rounded border border-[#E8E0D4]">
          <%= formato_codigo(@producto.codigo) %>
        </span>
      </div>
    <% end %>

    <!-- Description -->
    <% if @producto.descripcion.present? %>
      <p class="text-[#6B5744] leading-relaxed mb-6 whitespace-pre-wrap"><%= @producto.descripcion %></p>
    <% end %>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Pricing -->
    <% unless current_user.visitante? %>
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio compra</span>
          <p class="text-lg font-semibold text-[#2C1810] mt-1"><%= formato_precio(@producto.precio_compra) %></p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio venta</span>
          <p class="text-lg font-semibold text-[#B8860B] mt-1"><%= formato_precio(@producto.precio_venta) %></p>
        </div>
      </div>

      <% if @producto.precio_venta.present? && @producto.precio_compra.present? && @producto.precio_compra > 0 && @producto.precio_venta > @producto.precio_compra %>
        <% margin = ((@producto.precio_venta - @producto.precio_compra).to_f / @producto.precio_compra * 100).round(1) %>
        <div class="inline-flex items-center gap-1.5 bg-[#E8F0E8] text-[#5B7F5E] rounded-full px-3 py-1 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd"/></svg>
          Margen: +<%= margin %>%
        </div>
      <% end %>
    <% else %>
      <div class="mb-6">
        <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio</span>
        <p class="text-lg font-semibold text-[#B8860B] mt-1"><%= formato_precio(@producto.precio_venta) %></p>
      </div>
    <% end %>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Details -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 text-sm">
      <div>
        <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Categoría</span>
        <p class="font-semibold text-[#2C1810] mt-1"><%= link_to @producto.categoria.nombre, productos_path(categoria: @producto.categoria_id), class: "hover:text-[#B8860B] transition-colors" %></p>
      </div>
      <% unless current_user.visitante? %>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Publicado por</span>
          <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.user.nombre %></p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Fecha de creación</span>
          <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.created_at.strftime("%d/%m/%Y") %></p>
        </div>
        <% if @producto.last_updated_by.present? || @producto.updated_at > @producto.created_at %>
          <div class="flex items-center gap-2">
            <div>
              <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Última edición</span>
              <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.last_updated_by&.nombre || @producto.user&.nombre %> (<%= @producto.updated_at.strftime("%d/%m/%Y") %> <%= @producto.updated_at.strftime("a las %H:%M") %>)</p>
            </div>
            <% if @producto.historiales.any? %>
              <button type="button" data-controller="modal-trigger" data-action="click->modal#open" data-modal-id="historial-modal" class="ml-2 p-2 rounded-full bg-[#F5ECD7] hover:bg-[#E8DFC0] transition-colors" title="Ver historial de cambios">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#B8860B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </button>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% unless current_user.visitante? %>
      <% if current_user&.admin? || @producto.user_id == current_user&.id %>
        <div class="border-t border-[#E8E0D4] my-6"></div>

        <div class="flex gap-3">
          <%= link_to edit_producto_path(@producto), class: "inline-flex items-center gap-2 rounded-lg bg-[#B8860B] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] transition-all duration-200" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
            Editar
          <% end %>
          <%= button_to producto_path(@producto), method: :delete, data: { turbo_confirm: "¿Estás seguro de que deseas eliminar \"#{@producto.nombre.gsub('"', "'")}\"? Esta acción no se puede deshacer." }, class: "inline-flex items-center gap-2 rounded-lg border border-[#A63D2F] px-5 py-2.5 text-sm font-semibold text-[#A63D2F] hover:bg-[#A63D2F] hover:text-white transition-all duration-200 cursor-pointer" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Eliminar
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <% unless current_user.visitante? %>
    <% if current_user&.admin? || @producto.user_id == current_user&.id %>
      <div id="notas-seccion" data-controller="nota-crud" class="mt-8">
        <div class="bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-8">
          <h2 class="text-xl font-bold text-[#2C1810] mb-6">
            Notas (<%= @producto.notas.count %>)
          </h2>

          <%= form_with(url: producto_notas_path(@producto), class: "mb-8", local: true, data: { turbo: false }) do |f| %>
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <div class="flex flex-wrap gap-2">
              <%= f.text_area :contenido, placeholder: "Añadir una nota...", rows: 2, class: "flex-1 rounded-lg border border-[#E8E0D4] px-4 py-2 text-[#2C1810] placeholder-[#9C8B7A] focus:outline-none focus:border-[#B8860B] focus:ring-1 focus:ring-[#B8860B]", required: true, maxlength: 1000 %>
              <%= f.submit "Guardar", class: "px-4 py-2 bg-[#B8860B] text-white rounded-lg font-medium hover:bg-[#9A7209] transition-colors cursor-pointer" %>
            </div>
          <% end %>

          <div id="notas_list" class="space-y-4">
            <% @producto.notas.orden_recientes.each do |nota| %>
              <div class="p-4 rounded-lg bg-[#FAF7F2] border border-[#E8E0D4]">
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <span class="font-semibold text-[#2C1810] text-sm"><%= nota.user.nombre %></span>
                    <span class="text-xs text-[#9C8B7A] ml-2"><%= nota.created_at.strftime("%d/%m/%Y") %></span>
                    <% if nota.created_at != nota.updated_at %>
                      <span class="text-xs text-[#9C8B7A]">(editado)</span>
                    <% end %>
                  </div>
                  <div class="flex gap-2">
                    <button type="button" data-action="click->nota-crud#toggleEdit" data-id="<%= nota.id %>" class="text-[#9C8B7A] hover:text-[#B8860B] transition-colors p-1" title="Editar">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </button>
                    <button type="button" data-action="click->nota-crud#confirmDelete" data-id="<%= nota.id %>" data-preview='<%= nota.contenido.gsub("'", "\\'").slice(0, 50) %>' data-url="<%= producto_nota_path(@producto, nota) %>" class="text-[#9C8B7A] hover:text-[#A63D2F] transition-colors p-1" title="Eliminar">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </div>
                <p data-nota-crud-target="content" data-id="<%= nota.id %>" class="text-[#6B5744] text-sm whitespace-pre-wrap"><%= nota.contenido %></p>

                <div data-nota-crud-target="editForm" data-id="<%= nota.id %>" class="hidden mt-2">
                  <%= form_with(url: producto_nota_path(@producto, nota), method: :patch, local: true, data: { turbo: false }) do |f| %>
                    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
                    <div class="flex gap-2">
                      <%= f.text_area :contenido, rows: 2, class: "flex-1 rounded-lg border border-[#E8E0D4] px-3 py-2 text-sm text-[#2C1810] focus:outline-none focus:border-[#B8860B]", required: true, maxlength: 1000 %>
                      <div class="flex flex-col gap-1">
                        <%= f.submit "Guardar", class: "px-3 py-1 bg-[#B8860B] text-white text-sm rounded font-medium hover:bg-[#9A7209] transition-colors cursor-pointer" %>
                        <button type="button" data-action="click->nota-crud#toggleEdit" data-id="<%= nota.id %>" class="px-3 py-1 border border-[#E8E0D4] text-[#6B5744] text-sm rounded hover:bg-[#FAF7F2] transition-colors cursor-pointer">Cancelar</button>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @producto.notas.empty? %>
              <p class="text-center text-[#9C8B7A] py-4">No hay notas todavía</p>
            <% end %>
          </div>
        </div>

        <%# Nota Delete Modal %>
        <div id="nota-delete-modal" data-nota-crud-target="deleteModal" class="fixed inset-0 z-[100] hidden bg-black/50 items-center justify-center p-4">
          <div class="bg-white rounded-xl shadow-2xl w-full max-w-sm">
            <div class="p-4 border-b border-[#E8E0D4]">
              <h3 class="text-lg font-bold text-[#2C1810]">Confirmar eliminación</h3>
            </div>
            <div class="p-4">
              <p class="text-[#6B5744] mb-4">¿Estás seguro de que deseas eliminar esta nota?</p>
              <p data-nota-crud-target="deletePreview" class="text-sm text-[#9C8B7A] bg-[#FAF7F2] p-2 rounded border border-[#E8E0D4] mb-4 truncate"></p>
            </div>
            <div class="flex gap-3 p-4 border-t border-[#E8E0D4]">
              <button type="button" data-action="click->nota-crud#closeDeleteModal" class="flex-1 px-4 py-2 border border-[#E8E0D4] text-[#6B5744] rounded-lg font-medium hover:bg-[#FAF7F2] transition-colors cursor-pointer">Cancelar</button>
              <button type="button" data-action="click->nota-crud#executeDelete" class="flex-1 px-4 py-2 bg-[#A63D2F] text-white rounded-lg font-medium hover:bg-[#8B3329] transition-colors cursor-pointer">Eliminar</button>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Historial Modal -->
  <div id="historial-modal" data-controller="modal" data-action="click->modal#closeOnBackdrop" class="fixed inset-0 z-[100] hidden bg-black/50 items-center justify-center p-4">
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[80vh] overflow-hidden">
      <div class="flex items-center justify-between p-4 border-b border-[#E8E0D4]">
        <h3 class="text-lg font-bold text-[#2C1810]">Historial de cambios</h3>
        <button type="button" data-action="click->modal#close" class="text-gray-500 hover:text-gray-700 text-2xl font-bold cursor-pointer">&times;</button>
      </div>
      <div class="overflow-y-auto max-h-[calc(80vh-60px)] p-4">
        <% historiales = @producto.historiales.order(created_at: :desc).limit(50) %>
        <% if historiales.any? %>
          <div class="space-y-3">
            <% historiales.each do |h| %>
              <details class="group p-3 rounded-lg bg-[#FAF7F2] border border-[#E8E0D4] hover:bg-[#F5ECD7] transition-colors">
                <summary class="flex justify-between items-start cursor-pointer list-none">
                  <div>
                    <p class="font-semibold text-[#2C1810] text-sm"><%= h.user.nombre %></p>
                    <p class="text-xs text-[#9C8B7A]"><%= h.created_at.strftime("%d/%m/%Y") %> a las <%= h.created_at.strftime("%H:%M") %></p>
                  </div>
                  <span class="text-xs px-2 py-1 rounded-full bg-[#B8860B]/10 text-[#B8860B] font-medium"><%= h.campo %></span>
                </summary>
                <div class="mt-2 pt-2 border-t border-[#E8E0D4]">
                  <p class="text-sm text-[#2C1810] mb-2 font-medium"><%= h.resumen %></p>
                  <% if h.valor_anterior.present? && h.valor_nuevo.present? %>
                    <p class="text-xs text-[#9C8B7A]">Antes: <%= h.valor_anterior %></p>
                    <p class="text-xs text-[#9C8B7A]">Ahora: <%= h.valor_nuevo %></p>
                  <% elsif h.campo == "creado" %>
                    <p class="text-xs text-[#9C8B7A]">Producto creado</p>
                  <% else %>
                    <p class="text-xs text-[#9C8B7A]">Cambio registrado</p>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        <% else %>
          <p class="text-center text-[#9C8B7A] py-4">No hay cambios registrados</p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" data-lightbox-target="imageContainer" data-action="click->lightbox#closeOnBackdrop" class="fixed inset-0 z-[100] hidden bg-black/95 items-center justify-center">
    <button type="button" data-action="click->lightbox#close" class="absolute top-4 right-4 text-white text-4xl font-bold cursor-pointer hover:text-gray-300 z-10">&times;</button>
    <img data-lightbox-target="image" src="" class="max-w-full max-h-full object-contain cursor-zoom-out" data-action="click->lightbox#close">
    <div class="absolute bottom-4 left-0 right-0 text-center text-white text-sm">Click para cerrar / Click to close</div>
  </div>
</div>
