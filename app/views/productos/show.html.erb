<div class="w-full max-w-4xl mx-auto">
  <div class="mb-8">
    <%= link_to productos_path, class: "inline-flex items-center gap-1 text-[#B8860B] hover:text-[#9A7209] text-sm font-medium transition-all duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
      Volver al inventario
    <% end %>
  </div>

  <% if @producto.fotos.attached? %>
    <div class="mb-8" id="gallery" data-count="<%= @producto.fotos.count %>">
      <% fotos = @producto.fotos.to_a %>

      <%# Imagen principal (clickable para zoom) %>
      <div class="relative rounded-xl overflow-hidden shadow-md bg-[#FAF7F2]" style="aspect-ratio:4/3">
        <% fotos.each_with_index do |foto, i| %>
          <%= image_tag foto.variant(resize_to_limit: [800, 600]), class: "w-full h-full object-cover absolute inset-0 transition-opacity duration-300 cursor-zoom-in", style: (i == 0 ? "opacity:1" : "opacity:0"), data: { slide: i, zoom_url: url_for(foto) }, onclick: "openLightbox(this)" %>
        <% end %>
        <%
          etiqueta_colors = {
            "en_venta" => "bg-gradient-to-r from-green-500 to-emerald-500",
            "reservado" => "bg-gradient-to-r from-amber-500 to-orange-500",
            "vendido" => "bg-gradient-to-r from-red-500 to-rose-500",
            "en_restauracion" => "bg-gradient-to-r from-violet-500 to-purple-500"
          }
          etiqueta_textos = {
            "en_venta" => "EN VENTA",
            "reservado" => "RESERVADO",
            "vendido" => "VENDIDO",
            "en_restauracion" => "EN RESTAURACIÓN"
          }
        %>
        <div class="absolute top-0 left-0 w-full <%= etiqueta_colors[@producto.etiqueta] %> text-white text-xs font-bold text-center py-1">
          <%= etiqueta_textos[@producto.etiqueta] %>
        </div>

        <% if fotos.size > 1 %>
          <button type="button" id="galPrev" class="absolute left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 backdrop-blur flex items-center justify-center cursor-pointer hover:bg-white transition shadow-md">
            <svg class="w-5 h-5 text-[#2C1810]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" id="galNext" class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 backdrop-blur flex items-center justify-center cursor-pointer hover:bg-white transition shadow-md">
            <svg class="w-5 h-5 text-[#2C1810]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="absolute bottom-3 right-3 bg-black/50 text-white text-xs px-2 py-1 rounded-full" id="galCounter">1 / <%= fotos.size %></div>
        <% end %>
      </div>

      <%# Miniaturas %>
      <% if fotos.size > 1 %>
        <div class="flex gap-2 mt-3 overflow-x-auto pb-1" id="galThumbs">
          <% fotos.each_with_index do |foto, i| %>
            <button type="button" data-thumb="<%= i %>" data-zoom-url="<%= url_for(foto) %>" onclick="openLightboxFromThumb(this)" class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden border-2 cursor-pointer transition-all <%= i == 0 ? 'border-[#B8860B]' : 'border-transparent opacity-70 hover:opacity-100' %>">
              <%= image_tag foto.variant(resize_to_limit: [100, 100]), class: "w-full h-full object-cover" %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-8">
    <!-- Header -->
    <div class="flex justify-between items-start mb-2">
      <h1 class="text-3xl font-bold text-[#2C1810]" style="font-family: 'Playfair Display', serif;"><%= @producto.nombre %></h1>
      <%
        badge_colors = {
          "nuevo" => "bg-[#E8F0E8] text-[#3D5E3D]",
          "bueno" => "bg-[#E4ECF4] text-[#3D5470]",
          "aceptable" => "bg-[#F5ECD7] text-[#8B6914]",
          "desgastado" => "bg-[#F4E4DC] text-[#8B4F3A]",
          "restauracion" => "bg-[#F4DCDC] text-[#7F3333]"
        }
      %>
      <span class="inline-flex items-center rounded-full px-3 py-1 text-sm font-medium <%= badge_colors[@producto.estado] %>">
        <%= @producto.estado.humanize %>
      </span>
    </div>

    <!-- Código del producto -->
    <% if @producto.codigo.present? %>
      <div class="flex items-center gap-2 mb-6">
        <span class="text-sm text-[#9C8B7A]">Código:</span>
        <span class="text-sm font-bold text-[#2C1810] bg-[#F5ECD7] px-2 py-0.5 rounded border border-[#E8E0D4]">
          <%= formato_codigo(@producto.codigo) %>
        </span>
      </div>
    <% end %>

    <!-- Description -->
    <% if @producto.descripcion.present? %>
      <p class="text-[#6B5744] leading-relaxed mb-6 whitespace-pre-wrap"><%= @producto.descripcion %></p>
    <% end %>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Pricing -->
    <% unless current_user.visitante? %>
      <div class="grid grid-cols-2 gap-6 mb-6">
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio compra</span>
          <p class="text-lg font-semibold text-[#2C1810] mt-1"><%= formato_precio(@producto.precio_compra) %></p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio venta</span>
          <p class="text-lg font-semibold text-[#B8860B] mt-1"><%= formato_precio(@producto.precio_venta) %></p>
        </div>
      </div>

      <% if @producto.precio_venta.present? && @producto.precio_compra.present? && @producto.precio_compra > 0 && @producto.precio_venta > @producto.precio_compra %>
        <% margin = ((@producto.precio_venta - @producto.precio_compra).to_f / @producto.precio_compra * 100).round(1) %>
        <div class="inline-flex items-center gap-1.5 bg-[#E8F0E8] text-[#5B7F5E] rounded-full px-3 py-1 text-sm font-medium mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd"/></svg>
          Margen: +<%= margin %>%
        </div>
      <% end %>
    <% else %>
      <div class="mb-6">
        <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Precio</span>
        <p class="text-lg font-semibold text-[#B8860B] mt-1"><%= formato_precio(@producto.precio_venta) %></p>
      </div>
    <% end %>

    <div class="border-t border-[#E8E0D4] my-6"></div>

    <!-- Details -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 text-sm">
      <div>
        <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Categoría</span>
        <p class="font-semibold text-[#2C1810] mt-1"><%= link_to @producto.categoria.nombre, productos_path(categoria: @producto.categoria_id), class: "hover:text-[#B8860B] transition-colors" %></p>
      </div>
      <% unless current_user.visitante? %>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Publicado por</span>
          <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.user.nombre %></p>
        </div>
        <div>
          <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Fecha de creación</span>
          <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.created_at.strftime("%d/%m/%Y") %></p>
        </div>
        <% if @producto.last_updated_by.present? || @producto.updated_at > @producto.created_at %>
          <div class="flex items-center gap-2">
            <div>
              <span class="text-xs uppercase tracking-wider text-[#9C8B7A]">Última edición</span>
              <p class="font-semibold text-[#2C1810] mt-1"><%= @producto.last_updated_by&.nombre || @producto.user&.nombre %> (<%= @producto.updated_at.strftime("%d/%m/%Y") %> <%= @producto.updated_at.strftime("a las %H:%M") %>)</p>
            </div>
            <% if @producto.historiales.any? %>
              <button type="button" onclick="openHistorialModal()" class="ml-2 p-2 rounded-full bg-[#F5ECD7] hover:bg-[#E8DFC0] transition-colors" title="Ver historial de cambios">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#B8860B]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </button>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <% unless current_user.visitante? %>
      <% if current_user&.admin? || @producto.user_id == current_user&.id %>
        <div class="border-t border-[#E8E0D4] my-6"></div>

        <div class="flex gap-3">
          <%= link_to edit_producto_path(@producto), class: "inline-flex items-center gap-2 rounded-lg bg-[#B8860B] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] transition-all duration-200" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
            Editar
          <% end %>
          <button type="button" id="btnEliminar" data-url="<%= producto_path(@producto) %>" data-msg="¿Estás seguro de que deseas eliminar \"<%= @producto.nombre.gsub('"', "'") %>\"? Esta acción no se puede deshacer." class="inline-flex items-center gap-2 rounded-lg border border-[#A63D2F] px-5 py-2.5 text-sm font-semibold text-[#A63D2F] hover:bg-[#A63D2F] hover:text-white transition-all duration-200 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            Eliminar
          </button>
        </div>
      <% end %>
    <% end %>
  </div>
</div>

<script>
(function() {
  var gallery = document.getElementById('gallery');
  if (!gallery) return;
  
  var count = parseInt(gallery.dataset.count);
  if (count <= 1) return;
  
  var current = 0;
  var slides = gallery.querySelectorAll('[data-slide]');
  var thumbs = document.getElementById('galThumbs');
  var counter = document.getElementById('galCounter');
  var prevBtn = document.getElementById('galPrev');
  var nextBtn = document.getElementById('galNext');
  
  function showSlide(index) {
    current = index;
    if (current < 0) current = count - 1;
    if (current >= count) current = 0;
    
    slides.forEach(function(slide, i) {
      slide.style.opacity = (i === current) ? '1' : '0';
    });
    
    if (counter) {
      counter.textContent = (current + 1) + ' / ' + count;
    }
    
    if (thumbs) {
      thumbs.querySelectorAll('button').forEach(function(btn, i) {
        btn.classList.toggle('border-[#B8860B]', i === current);
        btn.classList.toggle('opacity-70', i !== current);
        btn.classList.toggle('opacity-100', i === current);
        btn.classList.toggle('border-transparent', i !== current);
      });
    }
  }
  
  if (prevBtn) {
    prevBtn.addEventListener('click', function(e) {
      e.preventDefault();
      showSlide(current - 1);
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', function(e) {
      e.preventDefault();
      showSlide(current + 1);
    });
  }
  
  if (thumbs) {
    thumbs.querySelectorAll('button').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        showSlide(parseInt(btn.dataset.thumb));
      });
    });
  }
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowLeft') showSlide(current - 1);
    if (e.key === 'ArrowRight') showSlide(current + 1);
  });
})();

  // Lightbox for photo zoom
  function openLightbox(img) {
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    if (lightbox && lightboxImg && img) {
      lightboxImg.src = img.dataset.zoomUrl || img.src;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function openLightboxFromThumb(btn) {
    var lightbox = document.getElementById('lightbox');
    var lightboxImg = document.getElementById('lightbox-img');
    if (lightbox && lightboxImg && btn) {
      lightboxImg.src = btn.dataset.zoomUrl;
      lightbox.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeLightbox() {
    var lightbox = document.getElementById('lightbox');
    if (lightbox) {
      lightbox.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('lightbox-close').addEventListener('click', closeLightbox);
  document.getElementById('lightbox').addEventListener('click', function(e) {
    if (e.target === this) closeLightbox();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeLightbox();
  });

  // Historial Modal
  function openHistorialModal() {
    var modal = document.getElementById('historial-modal');
    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeHistorialModal() {
    var modal = document.getElementById('historial-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.getElementById('historial-close').addEventListener('click', closeHistorialModal);
  document.getElementById('historial-modal').addEventListener('click', function(e) {
    if (e.target === this) closeHistorialModal();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeHistorialModal();
  });
</script>

<!-- Historial Modal -->
<div id="historial-modal" class="fixed inset-0 z-[100] hidden bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md max-h-[80vh] overflow-hidden">
    <div class="flex items-center justify-between p-4 border-b border-[#E8E0D4]">
      <h3 class="text-lg font-bold text-[#2C1810]" style="font-family: 'Playfair Display', serif;">Historial de cambios</h3>
      <button id="historial-close" class="text-gray-500 hover:text-gray-700 text-2xl font-bold cursor-pointer">&times;</button>
    </div>
    <div class="overflow-y-auto max-h-[calc(80vh-60px)] p-4">
      <% historiales = @producto.historiales.order(created_at: :desc).limit(50) %>
      <% if historiales.any? %>
        <div class="space-y-3">
          <% historiales.each do |h| %>
            <div class="p-3 rounded-lg bg-[#FAF7F2] border border-[#E8E0D4] cursor-pointer hover:bg-[#F5ECD7] transition-colors" onclick="this.classList.toggle('bg-[#F5ECD7]'); this.querySelector('.detalles').classList.toggle('hidden');">
              <div class="flex justify-between items-start">
                <div>
                  <p class="font-semibold text-[#2C1810] text-sm"><%= h.user.nombre %></p>
                  <p class="text-xs text-[#9C8B7A]"><%= h.created_at.strftime("%d/%m/%Y") %> a las <%= h.created_at.strftime("%H:%M") %></p>
                </div>
                <span class="text-xs px-2 py-1 rounded-full bg-[#B8860B]/10 text-[#B8860B] font-medium"><%= h.campo %></span>
              </div>
              <p class="text-sm text-[#2C1810] mt-2 font-medium"><%= h.resumen %></p>
              <div class="detalles hidden mt-2 pt-2 border-t border-[#E8E0D4]">
                <% if h.valor_anterior.present? && h.valor_nuevo.present? %>
                  <p class="text-xs text-[#9C8B7A]">Antes: <%= h.valor_anterior %></p>
                  <p class="text-xs text-[#9C8B7A]">Ahora: <%= h.valor_nuevo %></p>
                <% elsif h.campo == "creado" %>
                  <p class="text-xs text-[#9C8B7A]">Producto creado</p>
                <% else %>
                  <p class="text-xs text-[#9C8B7A]">Cambio registrado</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-center text-[#9C8B7A] py-4">No hay cambios registrados</p>
      <% end %>
    </div>
  </div>
</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 z-[100] hidden bg-black/95 flex items-center justify-center">
  <button id="lightbox-close" class="absolute top-4 right-4 text-white text-4xl font-bold cursor-pointer hover:text-gray-300 z-10">&times;</button>
  <img id="lightbox-img" src="" class="max-w-full max-h-full object-contain cursor-zoom-out" onclick="closeLightbox()">
  <div class="absolute bottom-4 left-0 right-0 text-center text-white text-sm">Click para cerrar / Click to close</div>
</div>
