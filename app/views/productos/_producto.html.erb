<%= turbo_frame_tag producto, class: "group block bg-white rounded-xl border border-[#E8E0D4] shadow-sm hover:shadow-lg hover:-translate-y-0.5 hover:border-b-[#B8860B] hover:border-b-2 transition-all duration-200 overflow-hidden h-full" do %>
  <%= link_to producto, data: { turbo_frame: "_top" }, class: "block w-full h-full relative" do %>
    <div class="aspect-square bg-[#FAF7F2] flex items-center justify-center overflow-hidden rounded-t-xl relative">
      <% if producto.fotos.attached? %>
        <%= image_tag producto.fotos.first.variant(resize_to_limit: [300, 300]), class: "object-cover w-full h-full group-hover:scale-105 transition-transform duration-300" %>
        <div class="absolute top-0 left-0 w-full">
          <%= render "productos/etiqueta_badge", etiqueta: producto.etiqueta, full_width: true %>
        </div>
        
        <%# IA Processing Overlay %>
        <% if producto.embedding.blank? %>
          <div class="absolute inset-0 bg-black/50 flex items-center justify-center z-10 backdrop-blur-[2px]">
            <div class="flex flex-col items-center text-white">
              <svg class="animate-spin h-8 w-8 mb-2 text-[#B8860B]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              <span class="text-[10px] uppercase tracking-wider font-bold">Procesando IA</span>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="flex flex-col items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-[#E8E0D4]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span class="text-[#9C8B7A] text-xs">Sin fotografía</span>
        </div>
        <div class="absolute top-0 left-0 w-full">
          <%= render "productos/etiqueta_badge", etiqueta: producto.etiqueta, full_width: true %>
        </div>
      <% end %>
    </div>
    <% if producto.codigo.present? || producto.notas.any? %>
      <div class="flex justify-end items-center gap-1 px-2 py-1 relative z-20 bg-white">
        <% if producto.codigo.present? %>
          <span class="text-xs font-bold text-[#6B5744] bg-[#F5ECD7] px-2 py-0.5 rounded border border-[#E8E0D4]">
            <%= producto.codigo %>
          </span>
        <% end %>
        <% if producto.notas.any? %>
          <span class="text-[#A63D2F]" title="<%= producto.notas.count %> nota(s)">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
            </svg>
          </span>
        <% end %>
      </div>
    <% end %>
    <div class="p-4 relative z-20 bg-white rounded-b-xl">
      <h2 class="font-semibold text-[#2C1810] truncate"><%= producto.nombre %></h2>
      <p class="text-lg font-bold text-[#B8860B] mt-1"><%= formato_precio(producto.precio_venta) %></p>
      <div class="flex items-center justify-between mt-3">
        <span class="text-xs text-[#9C8B7A]"><%= producto.categoria.nombre %></span>
        <%
          badge_colors = {
            "nuevo" => "bg-[#E8F0E8] text-[#3D5E3D]",
            "bueno" => "bg-[#E4ECF4] text-[#3D5470]",
            "aceptable" => "bg-[#F5ECD7] text-[#8B6914]",
            "desgastado" => "bg-[#F4E4DC] text-[#8B4F3A]",
            "para_restaurar" => "bg-[#F4DCDC] text-[#7F3333]"
          }
        %>
        <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= badge_colors[producto.estado] %>">
          <%= producto.estado.humanize %>
        </span>
      </div>
    </div>
  <% end %>
<% end %>
