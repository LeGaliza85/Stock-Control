<% if @error %>
  <%# Hide loading, show error %>
  <%= turbo_stream.update "searchLoading" do %>
  <% end %>
  <%= turbo_stream.update "searchResultsContent" do %>
    <div class="text-center py-8">
      <div class="w-12 h-12 rounded-full bg-[#F4DCDC] flex items-center justify-center mx-auto mb-4">
        <svg class="w-6 h-6 text-[#A63D2F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      </div>
      <p class="text-[#A63D2F] mb-4"><%= @error %></p>
      <button type="button" data-action="click->product-search#resetSearch" class="rounded-lg border border-[#A63D2F] px-6 py-2.5 text-sm font-medium text-[#A63D2F] hover:bg-[#F4DCDC] cursor-pointer transition-all duration-200">
        Reintentar
      </button>
    </div>
  <% end %>
<% elsif @productos.present? %>
  <%# Hide loading, show results %>
  <%= turbo_stream.update "searchLoading" do %>
  <% end %>
  <%= turbo_stream.update "searchResultsContent" do %>
    <div class="space-y-3 max-h-96 overflow-y-auto">
      <% @productos.each do |item| %>
        <%= render "productos/search_result_item", producto: item[:producto], similitud: item[:similitud] %>
      <% end %>
    </div>
    <div class="mt-4 text-center">
      <button type="button" data-action="click->product-search#resetSearch" class="text-[#10B981] text-sm font-medium hover:underline cursor-pointer">
        Buscar otra imagen
      </button>
    </div>
  <% end %>
<% else %>
  <%# Hide loading, show no results %>
  <%= turbo_stream.update "searchLoading" do %>
  <% end %>
  <%= turbo_stream.update "searchResultsContent" do %>
    <div class="text-center py-8">
      <svg class="w-12 h-12 mx-auto text-[#E8E0D4] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <p class="text-[#6B5744] font-medium mb-1">No se encontraron productos similares</p>
      <p class="text-sm text-[#9C8B7A]">Prueba con otra imagen o busca por texto</p>
      <button type="button" data-action="click->product-search#resetSearch" class="mt-3 text-[#10B981] text-sm font-medium hover:underline cursor-pointer">
        Intentar con otra imagen
      </button>
    </div>
  <% end %>
<% end %>
