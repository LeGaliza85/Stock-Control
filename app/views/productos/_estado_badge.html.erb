<%# Estado badge partial - locals: estado: %>
<%
  colors = {
    "nuevo" => "bg-[#E8F0E8] text-[#3D5E3D]",
    "bueno" => "bg-[#E4ECF4] text-[#3D5470]",
    "aceptable" => "bg-[#F5ECD7] text-[#8B6914]",
    "desgastado" => "bg-[#F4E4DC] text-[#8B4F3A]",
    "para_restaurar" => "bg-[#F4DCDC] text-[#7F3333]"
  }
  color = colors[estado] || "bg-gray-100 text-gray-600"
%>
<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= color %>">
  <%= estado.to_s.humanize %>
</span>
