<%# Etiqueta badge partial - locals: etiqueta:, full_width: true %>
<%
  colors = {
    "en_venta" => "bg-[#436850] text-white border-[#34523F]",
    "reservado" => "bg-[#A07D2C] text-white border-[#846724]",
    "vendido" => "bg-[#8C3A33] text-white border-[#75302A]",
    "en_restauracion" => "bg-[#7A5B44] text-white border-[#614836]"
  }
  textos = {
    "en_venta" => "EN VENTA",
    "reservado" => "RESERVADO",
    "vendido" => "VENDIDO",
    "en_restauracion" => "EN RESTAURACIÓN"
  }
  full_width = local_assigns[:full_width].nil? ? true : local_assigns[:full_width]
  color = colors[etiqueta] || "bg-[#6B5744] text-white border-[#514234]"
  texto = textos[etiqueta] || etiqueta.to_s.humanize
  width_class = full_width ? "w-full" : "px-3 rounded-md inline-block"
%>
<div class="<%= width_class %> <%= color %> text-[11px] font-bold text-center py-1.5 border-b uppercase tracking-widest shadow-md">
  <%= texto %>
</div>