<div data-controller="product-search">
  <%= turbo_stream_from "productos" %>
  <div class="w-full">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
      <h1 class="text-3xl font-bold text-[#2C1810]" style="font-family: 'Playfair Display', serif;">Inventario</h1>
      <% unless current_user.visitante? %>
        <div class="flex flex-col w-full gap-3 sm:flex-row">
          <button type="button" data-action="click->product-search#openSearchModal"
            class="inline-flex items-center justify-center sm:justify-start cursor-pointer gap-2 rounded-lg border-2 border-[#10B981] px-5 py-2.5 text-sm font-semibold text-[#10B981] hover:bg-[#10B981] hover:text-white transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            Buscar en stock
          </button>
          <button type="button" data-action="click->product-search#openIaModal"
            class="inline-flex items-center justify-center sm:justify-start cursor-pointer gap-2 rounded-lg border-2 border-[#7C3AED] px-5 py-2.5 text-sm font-semibold text-[#7C3AED] hover:bg-[#7C3AED] hover:text-white transition-all duration-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            Analizar con IA
          </button>
          <input type="file" data-product-search-target="iaFileInput" data-action="change->product-search#onIaFileChange" accept="image/*" capture="environment" class="hidden">
          <%= link_to new_producto_path, class: "inline-flex items-center justify-center sm:justify-start cursor-pointer gap-2 rounded-lg bg-[#B8860B] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] transition-all duration-200" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
            Nuevo Producto
          <% end %>
        </div>
      <% end %>
    </div>
    
    <%# Mobile Floating Buttons %>
    <% unless current_user.visitante? %>
      <div class="fixed bottom-6 right-6 z-50 md:hidden flex flex-col gap-3">
        <button type="button" data-action="click->product-search#openSearchModal"
          class="w-14 h-14 rounded-full bg-[#10B981] text-white shadow-lg border-none flex items-center justify-center cursor-pointer">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </button>
        <button type="button" data-action="click->product-search#openIaModal"
          class="w-14 h-14 rounded-full bg-[#7C3AED] text-white shadow-lg border-none flex items-center justify-center cursor-pointer">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </button>
        <%= link_to new_producto_path, class: "w-14 h-14 rounded-full bg-[#B8860B] text-white shadow-lg flex items-center justify-center cursor-pointer no-underline" do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Búsqueda de texto %>
  <div class="mb-4 px-2 sm:px-0">
    <%= form_with url: productos_path, method: :get, data: { controller: "search", turbo_frame: "productos" }, class: "flex flex-col sm:flex-row gap-2", autocomplete: "off" do |f| %>
      <%= f.hidden_field :categoria, value: params[:categoria] %>
      <%= f.hidden_field :estado, value: params[:estado] %>
      <%= f.hidden_field :etiqueta, value: params[:etiqueta] %>
      <%= f.hidden_field :per_page, value: @per_page %>
      <div class="relative flex-1">
        <%= f.text_field :q, value: params[:q], placeholder: "Buscar en el inventario...", data: { action: "input->search#search" }, id: "searchInput", class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] placeholder-[#9C8B7A] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 transition-all duration-200 p-3 text-base" %>
        <div id="searchSuggestions" class="hidden absolute top-full left-0 right-0 mt-1 bg-white rounded-lg border border-[#E8E0D4] shadow-lg z-50 max-h-60 overflow-y-auto"></div>
      </div>
      <%= f.submit "Buscar", class: "inline-flex items-center justify-center rounded-lg bg-[#6B5744] px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-[#2C1810] cursor-pointer transition-all duration-200" %>
    <% end %>
  </div>

  <%# Filtros %>
  <div class="mb-6">
    <div class="flex items-center gap-3">
      <details class="group flex-1" <%= "open" if params[:categoria].present? || params[:estado].present? || params[:etiqueta].present? %>>
        <summary class="inline-flex items-center gap-2 cursor-pointer text-sm font-medium text-[#6B5744] hover:text-[#2C1810] transition-colors select-none">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 011-1h12a1 1 0 011 1v3a1 1 0 01-.293.707L12 11.414V15a1 1 0 01-.293.707l-2 2A1 1 0 018 17v-5.586L3.293 6.707A1 1 0 013 6V3z" clip-rule="evenodd"/></svg>
          Filtros
          <% active_filters = [params[:categoria].present?, params[:estado].present?, params[:etiqueta].present?, params[:vistos] == "true"].count(true) %>
          <% if active_filters > 0 %>
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-[#B8860B] text-white text-xs font-bold"><%= active_filters %></span>
          <% end %>
        </summary>
        <div class="mt-3 bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-5">
          <%= form_with url: productos_path, method: :get, data: { turbo_frame: "productos", controller: "filtros" }, class: "flex flex-col sm:flex-row gap-4 items-end" do |f| %>
            <%= f.hidden_field :q, value: params[:q] %>
            <%= f.hidden_field :per_page, value: @per_page %>
            <div class="flex-1">
              <%= f.label :categoria, "Categoría", class: "block text-xs font-medium text-[#6B5744] mb-1" %>
              <%= f.select :categoria, options_for_select(@categorias_para_filtro, params[:categoria]), { include_blank: "Todas" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 text-sm", data: { action: "change->filtros#submit" } %>
            </div>
            <div class="flex-1">
              <%= f.label :estado, "Estado", class: "block text-xs font-medium text-[#6B5744] mb-1" %>
              <%= f.select :estado, options_for_select(Producto.estados.keys.map { |e| [e.humanize, e] }, params[:estado]), { include_blank: "Todos" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 text-sm", data: { action: "change->filtros#submit" } %>
            </div>
            <div class="flex-1">
              <%= f.label :etiqueta, "Etiqueta", class: "block text-xs font-medium text-[#6B5744] mb-1" %>
              <%= f.select :etiqueta, options_for_select(Producto.etiquetas.keys.map { |e| [e.humanize, e] }, params[:etiqueta]), { include_blank: "Todas" }, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 text-sm", data: { action: "change->filtros#submit" } %>
            </div>
            <% unless current_user.visitante? %>
              <div class="flex-1">
                <%= f.label :vistos, "Ver", class: "block text-xs font-medium text-[#6B5744] mb-1" %>
                <%= f.select :vistos, options_for_select([["Todos", ""], ["Vistos recientemente", "true"]], params[:vistos]), {}, class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 text-sm", data: { action: "change->filtros#submit" } %>
              </div>
            <% end %>
            <%= link_to "Limpiar", productos_path(per_page: @per_page), class: "rounded-lg border border-[#E8E0D4] px-4 py-2 text-sm font-medium text-[#6B5744] hover:bg-[#F5ECD7] transition-all" %>
          <% end %>
        </div>
      </details>
      <% if params[:categoria].present? || params[:estado].present? || params[:etiqueta].present? || params[:vistos] == "true" || params[:q].present? %>
        <%= link_to productos_path(per_page: @per_page), class: "inline-flex items-center gap-1 rounded-lg border border-[#E8E0D4] px-3 py-1.5 text-xs font-medium text-[#A63D2F] hover:bg-[#F4DCDC] transition-colors" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
          Limpiar filtros
        <% end %>
      <% end %>
    </div>
  </div>

  <%# Grid de productos %>
  <div class="flex items-center justify-between mb-4 text-sm text-[#9C8B7A]">
    <span>
      <% if @total > 0 %>
        Mostrando <%= (@page - 1) * @per_page + 1 %>-<%= [@page * @per_page, @total].min %> de <%= @total %>
      <% else %>
        Sin resultados
      <% end %>
    </span>
    <%= form_with url: productos_path, method: :get, data: { turbo_frame: "productos" }, class: "flex items-center gap-2" do |f| %>
      <%= f.hidden_field :q, value: params[:q] %>
      <%= f.hidden_field :categoria, value: params[:categoria] %>
      <%= f.hidden_field :estado, value: params[:estado] %>
      <%= f.hidden_field :etiqueta, value: params[:etiqueta] %>
      <%= f.hidden_field :vistos, value: params[:vistos] %>
      <span>Por página:</span>
      <%= f.select :per_page, options_for_select([12, 24, 48], @per_page), {}, class: "rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] text-sm px-2 py-1", onchange: "this.form.requestSubmit()" %>
    <% end %>
  </div>

  <%= turbo_frame_tag "productos" do %>
    <% if @productos.any? %>
      <div id="productos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <%= render partial: 'producto', collection: @productos %>
      </div>
      <%# Paginación %>
      <% total_pages = (@total.to_f / @per_page).ceil %>
      <% if total_pages > 1 %>
        <div class="flex items-center justify-center gap-2 mt-8">
          <% if @page > 1 %>
            <%= link_to productos_path(q: params[:q], categoria: params[:categoria], estado: params[:estado], etiqueta: params[:etiqueta], per_page: @per_page, page: @page - 1), class: "inline-flex items-center gap-1 rounded-lg border border-[#E8E0D4] px-3 py-2 text-sm text-[#6B5744] hover:bg-[#F5ECD7] transition-all" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Anterior
            <% end %>
          <% end %>
          <% (1..total_pages).each do |p| %>
            <% if p == @page %>
              <span class="inline-flex items-center rounded-lg bg-[#B8860B] px-3.5 py-2 text-sm font-semibold text-white"><%= p %></span>
            <% elsif p == 1 || p == total_pages || (p - @page).abs <= 1 %>
              <%= link_to p, productos_path(q: params[:q], categoria: params[:categoria], estado: params[:estado], etiqueta: params[:etiqueta], per_page: @per_page, page: p), class: "inline-flex items-center rounded-lg border border-[#E8E0D4] px-3.5 py-2 text-sm text-[#6B5744] hover:bg-[#F5ECD7] transition-all" %>
            <% elsif (p - @page).abs == 2 %>
              <span class="px-1 text-[#9C8B7A]">…</span>
            <% end %>
          <% end %>
          <% if @page < total_pages %>
            <%= link_to productos_path(q: params[:q], categoria: params[:categoria], estado: params[:estado], etiqueta: params[:etiqueta], per_page: @per_page, page: @page + 1), class: "inline-flex items-center gap-1 rounded-lg border border-[#E8E0D4] px-3 py-2 text-sm text-[#6B5744] hover:bg-[#F5ECD7] transition-all" do %>
              Siguiente
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="text-center py-16">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-[#E8E0D4] mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <p class="text-[#9C8B7A] text-lg" style="font-family: 'Playfair Display', serif;">No se encontraron piezas en el inventario.</p>
        <p class="text-[#9C8B7A] text-sm mt-1">Intenta ajustar los filtros o agrega un nuevo producto.</p>
      </div>
    <% end %>
  <% end %>

  <%# --- MODALES --- %>

  <%# Modal: Buscar en Stock (Turbo) %>
  <div data-product-search-target="searchModal" data-action="click->product-search#closeOnBackdrop"
    class="hidden fixed inset-0 z-[200] flex items-center justify-center p-4 bg-[#1C1814]/85">
    <div class="bg-white rounded-xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold text-[#2C1810]" style="font-family: 'Playfair Display', serif;">Buscar en el inventario</h3>
          <button type="button" data-action="click->product-search#closeSearchModal"
            class="w-8 h-8 rounded-full bg-[#F5ECD7] flex items-center justify-center cursor-pointer hover:bg-[#E8DCC8] transition-colors">
            <svg class="w-5 h-5 text-[#6B5744]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        
        <p class="text-sm text-[#6B5744] mb-4">Sube una foto para buscar productos similares.</p>
        
        <%= form_with url: buscar_por_imagen_productos_path, method: :post, multipart: true, data: { product_search_target: "searchForm" } do |f| %>
          <div data-product-search-target="searchOptions" class="mb-4 flex gap-3">
            <label for="searchGaleria" class="flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg border-2 border-[#10B981] text-[#10B981] font-medium hover:bg-[#10B981] hover:text-white transition-all cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Galería
            </label>
            <input type="file" id="searchGaleria" name="imagen_galeria" data-action="change->product-search#onSearchFileChange" accept="image/*" class="hidden">
            
            <label for="searchCamara" class="flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg border-2 border-[#10B981] text-[#10B981] font-medium hover:bg-[#10B981] hover:text-white transition-all cursor-pointer">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              Cámara
            </label>
            <input type="file" id="searchCamara" name="imagen_camara" data-action="change->product-search#onSearchFileChange" accept="image/*" capture="environment" class="hidden">
          </div>
        <% end %>

        <div data-product-search-target="searchPreview" class="mb-4 rounded-lg overflow-hidden bg-[#FAF7F2] flex items-center justify-center min-h-[150px]">
          <div class="text-center py-8 text-[#9C8B7A]">
            <p class="text-sm">Selecciona una opción arriba</p>
          </div>
        </div>

        <div id="searchLoading" data-product-search-target="searchLoading" class="hidden text-center py-8">
          <div class="relative inline-block w-16 h-16 mb-4">
            <div class="absolute inset-0 rounded-full border-4 border-[#10B981]/20"></div>
            <div class="absolute inset-0 rounded-full border-4 border-transparent border-t-[#10B981] animate-spin"></div>
          </div>
          <p class="text-lg font-semibold text-[#2C1810]">Buscando...</p>
        </div>

        <div id="searchResultsContent" data-product-search-target="searchResults"></div>
      </div>
    </div>
  </div>

  <%# Modal: Análisis IA (JSON) %>
  <%= render "shared/ia_modal", show_fill_form: false %>
</div>
