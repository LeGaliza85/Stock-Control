<div class="w-full max-w-2xl mx-auto">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
    <h1 class="text-3xl font-bold text-[#2C1810]" style="font-family: 'Playfair Display', serif;">Categorías</h1>
    <%= link_to new_categoria_path, class: "inline-flex items-center gap-2 rounded-lg bg-[#B8860B] px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] transition-all duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
      Nueva Categoría
    <% end %>
  </div>

  <% if @categorias.any? %>
    <div class="bg-white rounded-xl border border-[#E8E0D4] shadow-sm divide-y divide-[#E8E0D4]">
      <% @categorias.each do |categoria| %>
        <div class="flex items-center justify-between px-6 py-4 group hover:bg-[#FAF7F2] transition-colors">
          <div>
            <span class="font-semibold text-[#2C1810]"><%= categoria.nombre %></span>
            <span class="ml-2 text-xs text-[#9C8B7A]">(<%= pluralize(categoria.productos.count, "producto") %>)</span>
          </div>
          <div class="flex items-center gap-2">
            <%= link_to edit_categoria_path(categoria), class: "inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-[#6B5744] hover:bg-[#F5ECD7] transition-colors" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
              Editar
            <% end %>
            <%= button_to categoria, method: :delete, data: { turbo_confirm: "¿Estás seguro de que deseas eliminar '#{categoria.nombre}'?" }, class: "inline-flex items-center gap-1 rounded-lg px-3 py-1.5 text-xs font-medium text-[#A63D2F] hover:bg-[#F4DCDC] transition-colors cursor-pointer" do %>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
              Eliminar
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 mx-auto text-[#E8E0D4] mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
      <p class="text-[#9C8B7A] text-lg" style="font-family: 'Playfair Display', serif;">No hay categorías aún.</p>
      <p class="text-[#9C8B7A] text-sm mt-1">Crea la primera categoría para organizar tus productos.</p>
    </div>
  <% end %>
</div>
