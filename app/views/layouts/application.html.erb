<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "StockControl" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="StockControl">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" style="background-color: var(--bg-cream); color: var(--text-primary); font-family: 'DM Sans', sans-serif;">
    <%# Navbar %>
    <nav class="sticky top-0 z-50 shadow-lg" style="background-color: var(--navbar-bg);">
      <div class="container mx-auto px-4 py-3 flex items-center justify-between">
        <%= link_to root_path, class: "hover:opacity-80 transition-opacity" do %>
          <span style="font-family: 'Playfair Display', serif; color: var(--accent);" class="text-xl font-bold tracking-tight">StockControl</span>
        <% end %>

        <%# Desktop menu %>
        <div class="hidden md:flex items-center gap-5">
          <% if authenticated? %>
            <span class="text-sm" style="color: var(--text-muted);"><%= Current.session.user.nombre %></span>
            <%= link_to "Productos", productos_path, class: "text-sm font-medium transition-colors", style: "color: #E8E0D4;", onmouseover: "this.style.color='#B8860B'", onmouseout: "this.style.color='#E8E0D4'" rescue nil %>
            <%= link_to "Categorías", categorias_path, class: "text-sm font-medium transition-colors", style: "color: #E8E0D4;", onmouseover: "this.style.color='#B8860B'", onmouseout: "this.style.color='#E8E0D4'" rescue nil %>
            <%= button_to "Cerrar sesion", session_path, method: :delete, class: "text-sm px-3 py-1.5 rounded cursor-pointer font-medium transition-colors", style: "color: var(--text-muted); border: 1px solid #3D2E28;", onmouseover: "this.style.borderColor='#6B5744'; this.style.color='#E8E0D4'", onmouseout: "this.style.borderColor='#3D2E28'; this.style.color='var(--text-muted)'" %>
          <% else %>
            <%= link_to "Iniciar sesion", new_session_path, class: "text-sm font-medium transition-colors", style: "color: #E8E0D4;", onmouseover: "this.style.color='#B8860B'", onmouseout: "this.style.color='#E8E0D4'" %>
            <%= link_to "Registro", new_registration_path, class: "text-sm px-4 py-1.5 rounded font-medium transition-colors", style: "background-color: var(--accent); color: #FAF7F2;", onmouseover: "this.style.backgroundColor='#9A7209'", onmouseout: "this.style.backgroundColor='#B8860B'" %>
          <% end %>
        </div>

        <%# Mobile menu %>
        <details class="md:hidden relative">
          <summary class="list-none cursor-pointer p-2" style="color: var(--accent);">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </summary>
          <div class="absolute right-0 mt-2 w-52 rounded-lg shadow-xl py-2 z-50" style="background-color: #2A1E1A; border: 1px solid #3D2E28;">
            <% if authenticated? %>
              <span class="block px-4 py-2 text-sm" style="color: var(--text-muted);"><%= Current.session.user.nombre %></span>
              <div style="border-top: 1px solid #3D2E28; margin: 0.25rem 1rem;"></div>
              <%= link_to "Productos", productos_path, class: "block px-4 py-2 text-sm transition-colors", style: "color: #E8E0D4;" rescue nil %>
              <%= link_to "Categorías", categorias_path, class: "block px-4 py-2 text-sm transition-colors", style: "color: #E8E0D4;" rescue nil %>
              <%= button_to "Cerrar sesion", session_path, method: :delete, class: "w-full text-left px-4 py-2 text-sm cursor-pointer transition-colors", style: "color: var(--text-muted);" %>
            <% else %>
              <%= link_to "Iniciar sesion", new_session_path, class: "block px-4 py-2 text-sm transition-colors", style: "color: #E8E0D4;" %>
              <%= link_to "Registro", new_registration_path, class: "block px-4 py-2 text-sm transition-colors", style: "color: var(--accent);" %>
            <% end %>
          </div>
        </details>
      </div>
      <%# Decorative amber line below navbar %>
      <div style="height: 2px; background: linear-gradient(90deg, transparent, var(--accent), transparent);"></div>
    </nav>

    <%# Flash messages %>
    <% if notice %>
      <div class="container mx-auto px-4 mt-4">
        <div class="px-4 py-3 rounded-lg text-sm flex items-center justify-between" style="background-color: #E8F0E8; border: 1px solid #C4D9C4; color: #3D5E3D;">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span><%= notice %></span>
          </div>
          <button onclick="this.parentElement.parentElement.remove()" class="ml-4 font-bold cursor-pointer opacity-60 hover:opacity-100">&times;</button>
        </div>
      </div>
    <% end %>
    <% if alert %>
      <div class="container mx-auto px-4 mt-4">
        <div class="px-4 py-3 rounded-lg text-sm flex items-center justify-between" style="background-color: #F4DCDC; border: 1px solid #E0B8B8; color: #7F3333;">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
            <span><%= alert %></span>
          </div>
          <button onclick="this.parentElement.parentElement.remove()" class="ml-4 font-bold cursor-pointer opacity-60 hover:opacity-100">&times;</button>
        </div>
      </div>
    <% end %>

    <%# Main content %>
    <main class="container mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <%# Footer %>
    <footer class="mt-auto py-6 text-center text-xs" style="color: var(--text-muted); border-top: 1px solid var(--border);">
      <div class="container mx-auto px-4">
        <span style="font-family: 'Playfair Display', serif; color: var(--accent);">StockControl</span>
        <span class="mx-2">&middot;</span>
        &copy; <%= Date.current.year %>
      </div>
    </footer>
    <script>document.addEventListener("click",function(e){var p=e.target.closest("#passBtn");if(p){var i=document.getElementById("pass"),s=document.getElementById("passEye");if(i){if(i.type==="password"){i.type="text";s.setAttribute("d","M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21")}else{i.type="password";s.setAttribute("d","M15 12a3 3 0 11-6 0 3 3 0 016 0zM2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z")}}return}var b=e.target.closest("#btnEliminar,#btnEliminarCat");if(b){e.preventDefault();var url=b.getAttribute("data-url"),msg=b.getAttribute("data-msg"),tok=document.querySelector("meta[name=csrf-token]");if(confirm(msg)){fetch(url,{method:"DELETE",headers:{"X-CSRF-Token":tok?tok.content:""}}).then(function(r){if(r.ok){window.location.reload()}})}}});</script>
    <script>var si=document.getElementById("searchInput"),ss=document.getElementById("searchSuggestions"),st;function showS(a){if(!ss)return;ss.innerHTML="";a.forEach(function(t){var d=document.createElement("div");d.textContent=t;d.style.cssText="padding:8px 12px;cursor:pointer;font-size:14px;color:#2C1810";d.onmouseover=function(){d.style.background="#F5ECD7"};d.onmouseout=function(){d.style.background="white"};d.onclick=function(){si.value=t;ss.classList.add("hidden");si.form.requestSubmit()};ss.appendChild(d)});if(a.length>0)ss.classList.remove("hidden")}if(si){si.addEventListener("input",function(){clearTimeout(st);var q=this.value.trim();if(q.length<2){ss.classList.add("hidden");return}st=setTimeout(function(){fetch("/productos/suggestions?q="+encodeURIComponent(q)).then(function(r){return r.json()}).then(function(d){showS(d)})},200)});document.addEventListener("click",function(e){if(ss&&!e.target.closest("#searchInput")&&!e.target.closest("#searchSuggestions"))ss.classList.add("hidden")})}</script>
    <script>document.addEventListener("change",function(e){if(e.target.id==="fotosInput"){var pv=document.querySelector("[data-camera-target=preview]");if(!pv)return;Array.from(e.target.files).forEach(function(f){if(!f.type.startsWith("image/"))return;var r=new FileReader();r.onload=function(ev){var w=document.createElement("div");w.style.cssText="position:relative;display:inline-block";var img=document.createElement("img");img.src=ev.target.result;img.style.cssText="width:80px;height:80px;object-fit:cover;border-radius:8px;border:2px solid #B8860B";var x=document.createElement("button");x.type="button";x.innerHTML="&times;";x.style.cssText="position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;background:#A63D2F;color:white;font-size:12px;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity 0.2s";w.onmouseenter=function(){x.style.opacity="1"};w.onmouseleave=function(){x.style.opacity="0"};x.onclick=function(){w.remove()};w.appendChild(img);w.appendChild(x);pv.appendChild(w)};r.readAsDataURL(f)})}});</script>
    <script>(function(){var g=document.getElementById("gallery");if(!g)return;var cur=0,n=parseInt(g.dataset.count),slides=g.querySelectorAll("[data-slide]"),thumbs=g.querySelectorAll("[data-thumb]"),ctr=document.getElementById("galCounter");function go(i){cur=((i%n)+n)%n;slides.forEach(function(s,j){s.style.opacity=j===cur?"1":"0"});thumbs.forEach(function(t,j){t.classList.toggle("border-[#B8860B]",j===cur);t.classList.toggle("border-transparent",j!==cur);t.classList.toggle("opacity-70",j!==cur);if(j===cur)t.scrollIntoView({behavior:"smooth",block:"nearest",inline:"center"})});if(ctr)ctr.textContent=(cur+1)+" / "+n}var p=document.getElementById("galPrev"),nx=document.getElementById("galNext");if(p)p.addEventListener("click",function(){go(cur-1)});if(nx)nx.addEventListener("click",function(){go(cur+1)});thumbs.forEach(function(t){t.addEventListener("click",function(){go(parseInt(t.dataset.thumb))})});document.addEventListener("keydown",function(e){if(e.key==="ArrowLeft")go(cur-1);if(e.key==="ArrowRight")go(cur+1)});var sx;g.addEventListener("touchstart",function(e){sx=e.touches[0].clientX},{passive:true});g.addEventListener("touchend",function(e){if(sx==null)return;var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>50){go(dx<0?cur+1:cur-1)}sx=null},{passive:true})})();</script>
    <script>(function(){var df=document.getElementById("descripcionField");if(!df)return;var C={"tambien":"también","ademas":"además","asi":"así","aqui":"aquí","ahi":"ahí","dia":"día","paises":"países","musica":"música","numero":"número","telefono":"teléfono","sabado":"sábado","miercoles":"miércoles","habitacion":"habitación","comunicacion":"comunicación","atencion":"atención","razon":"razón","informacion":"información","edicion":"edición","condicion":"condición","produccion":"producción","educacion":"educación","situacion":"situación","funcion":"función","opinion":"opinión","descripcion":"descripción","publicacion":"publicación","restauracion":"restauración","marmol":"mármol","clasico":"clásico","clasica":"clásica","unico":"único","unica":"única","pequeno":"pequeño","pequena":"pequeña","tamano":"tamaño","exposicion":"exposición","senal":"señal","diseno":"diseño","regimen":"régimen","diametro":"diámetro","accion":"acción","cancion":"canción","organizacion":"organización","clasificacion":"clasificación","reparacion":"reparación","escultura":"escultura","tallado":"tallado","dorado":"dorado","plateado":"plateado","patina":"pátina","esmalte":"esmalte","tirador":"tirador","bisagra":"bisagra","cerradura":"cerradura","repujado":"repujado","aproximadamente":"aproximadamente","aproximado":"aproximado","caracteristicas":"características","unicamente":"únicamente","automaticamente":"automáticamente","logicamente":"lógicamente","practicamente":"prácticamente","sincronizacion":"sincronización","cajon":"cajón","haber":"a ver","aver":"a ver","haiga":"haya","huviera":"hubiera","nadien":"nadie","muncho":"mucho","setiembre":"septiembre","murciegalo":"murciélago","almóndiga":"albóndiga","conclusion":"conclusión","hechar":"echar","asta":"hasta","muy bueno":"muy bueno","bien":"bien","bueno":"bueno"};function corregir(){var t=df.value,r=t;Object.keys(C).forEach(function(w){var re=new RegExp("\\b"+w+"\\b","gi");r=r.replace(re,function(m){return m[0]===m[0].toUpperCase()?C[w][0].toUpperCase()+C[w].slice(1):C[w]})});r=r.replace(/  +/g," ");r=r.replace(/ +\./g,".");r=r.replace(/ +,/g,",");r=r.replace(/\( +/g,"(");r=r.replace(/ +\)/g,")");r=r.replace(/\.\./g,".");if(r.length>10&&!r.match(/[.!?"\)]$/))r=r.trim()+".";if(r.length>0)r=r[0].toUpperCase()+r.slice(1);if(r!==t){var p=df.selectionStart;df.value=r;df.setSelectionRange(p,p)}}df.addEventListener("blur",corregir);
var frm = df.closest("form");
if (frm) frm.addEventListener("submit", corregir);
})();</script>
  </body>
</html>
