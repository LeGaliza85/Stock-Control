e()+C[w].slice(1):C[w]})});r=r.replace(/  +/g," ");r=r.replace(/ +\./g,".");r=r.replace(/ +,/g,",");r=r.replace(/\( +/g,"(");r=r.replace(/ +\)/g,")");r=r.replace(/\.\./g,".");if(r.length>10&&!r.match(/[.!?"\)]$/))r=r.trim()+".";if(r.length>0)r=r[0].toUpperCase()+r.slice(1);if(r!==t){var p=df.selectionStart;df.value=r;df.setSelectionRange(p,p)}}df.addEventListener("blur",corregir);
