<!DOCTYPE html>
<html>
<head>
  <title>StockControl</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen" style="background-color: var(--bg-cream); color: var(--text-primary); font-family: 'DM Sans', sans-serif;">
  <!-- Cabecera con logo, centro y menú principal a la derecha -->
  <nav class="sticky top-0 z-50 shadow-lg" style="background-color: var(--navbar-bg);">
    <div class="container mx-auto px-4 py-3" style="display:flex; align-items:center; justify-content:space-between; gap:12px;">
      <!-- Logo a la izquierda -->
      <div style="display:flex; align-items:center; gap:8px;">
        <%= link_to root_path do %>
          <%= image_tag "logo.webp", alt: "StockControl", class: "w-8 h-8" %>
        <% end %>
      </div>

      <!-- Centro: Productos y Categorías -->
      <div style="flex:1; display:flex; justify-content:center; gap:28px;">
        <a href="<%= productos_path %>" style="color:#E8E0D4; text-decoration:none; font-size:14px;">Productos</a>
        <a href="<%= categorias_path %>" style="color:#E8E0D4; text-decoration:none; font-size:14px;">Categorías</a>
      </div>

      <!-- Derecha: Botón de Menu Principal y nombre de usuario (sin avatar) -->
      <div style="display:flex; align-items:center; gap:8px;">
        <button id="headerMainBtn" onclick="toggleHeaderMainMenu(event)" style="background: transparent; border:1px solid #E8E0D4; color:#E8E0D4; padding:6px 12px; border-radius:6px; cursor:pointer;">Menu</button>
        <div id="headerUsername" style="padding:6px 12px; border-radius:6px; border:1px solid #E8E0D4; background:transparent; color:var(--accent); font-weight:600;">
          <%= current_user.nombre %>
        </div>
      </div>
    </div>

    <!-- Dropdown del header para Menu (Productos, Categorías, IA) -->
    <div id="headerMainMenuDropdown" class="hidden" style="position:absolute; right:20px; top:56px; background:#2A1E1A; border:1px solid #3D2E28; border-radius:6px; min-width:180px; padding:8px;">
      <a href="<%= productos_path %>" class="block" style="color:#E8E0D4; text-decoration:none; padding:6px 8px; display:block;">Productos</a>
      <a href="<%= categorias_path %>" class="block" style="color:#E8E0D4; text-decoration:none; padding:6px 8px; display:block;">Categorías</a>
      <% if current_user.rol == 'admin' %>
      <a href="<%= config_ia_path %>" class="block" style="color:#E8E0D4; text-decoration:none; padding:6px 8px; display:block;">Configuración IA</a>
      <% end %>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-8">
    <%= yield %>
  </main>

  <script>
    function toggleHeaderMainMenu(e) {
      e.preventDefault();
      var el = document.getElementById('headerMainMenuDropdown');
      if (el) el.classList.toggle('hidden');
    }
    // Opcional: cerrar dropdown si se hace click fuera
    document.addEventListener('click', function(ev) {
      var menu = document.getElementById('headerMainMenuDropdown');
      var btn = document.getElementById('headerMainBtn');
      if (menu && !menu.contains(ev.target) && !btn.contains(ev.target)) {
        menu.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
