=df.closest("form");if(frm)frm.addEventListener("submit",corregir)})();</script>
<script>
(function() {
  var modal = document.getElementById('iaModal');
  var btnAnalizar = document.getElementById('btnAnalizarIA');
  var btnClose = document.getElementById('closeIaModal');
  var btnCancel = document.getElementById('btnCancelarIA');
  var btnAplicar = document.getElementById('btnAplicarIA');
  var btnCrearProducto = document.getElementById('btnCrearProductoIA');
  var btnRetry = document.getElementById('btnRetryIA');
  var iaCameraInput = document.getElementById('iaCameraInput');
  var loading = document.getElementById('iaLoading');
  var results = document.getElementById('iaResults');
  var errorDiv = document.getElementById('iaError');
  var imagePreview = document.getElementById('iaImagePreview');
  var csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
  var currentImageData = null;
  var currentAnalysis = null;

  if (btnAnalizar && iaCameraInput) {
    btnAnalizar.addEventListener('click', function() {
      var imageData = getImageToAnalyze();
      if (imageData) {
        openModalWithImage(imageData);
      } else {
        iaCameraInput.click();
      }
    });
  }

  if (iaCameraInput) {
    iaCameraInput.addEventListener('change', function(e) {
      if (e.target.files && e.target.files[0]) {
        openModalWithImage(e.target.files[0]);
      }
    });
  }

  function getImageToAnalyze() {
    var previewContainer = document.querySelector('[data-photo-preview-target="preview"]');
    var previewImages = previewContainer ? previewContainer.querySelectorAll('img') : [];
    var existingPhotos = document.querySelectorAll('.foto-item img');
    if (previewImages.length > 0) return previewImages[0].src;
    if (existingPhotos.length > 0) return existingPhotos[0].src;
    var cameraInput = document.getElementById('cameraInput');
    var fotosInput = document.getElementById('fotosInput');
    if (cameraInput && cameraInput.files && cameraInput.files[0]) return cameraInput.files[0];
    if (fotosInput && fotosInput.files && fotosInput.files[0]) return fotosInput.files[0];
    return null;
  }

  function fileToBase64(file) {
    return new Promise(function(resolve, reject) {
      var reader = new FileReader();
      reader.onload = function() { resolve(reader.result); };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function openModalWithImage(imageData) {
    if (!modal) return;
    currentImageData = imageData;
    resetModal();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    if (typeof imageData === 'object' && imageData.type) {
      fileToBase64(imageData).then(function(base64) {
        currentImageData = base64;
        showImagePreview(base64);
        analyzeImage();
      });
    } else {
      showImagePreview(imageData);
      analyzeImage();
    }
  }

  function showImagePreview(src) {
    if (imagePreview) imagePreview.innerHTML = '<img src="' + src + '" class="max-h-48 mx-auto rounded-lg">';
  }

  function resetModal() {
    if (loading) loading.classList.add('hidden');
    if (results) results.classList.add('hidden');
    if (errorDiv) errorDiv.classList.add('hidden');
    var errorMsg = document.getElementById('iaErrorMsg');
    if (errorMsg) errorMsg.textContent = 'Error al analizar la imagen';
  }

  function analyzeImage() {
    if (!loading) return;
    loading.classList.remove('hidden');
    if (results) results.classList.add('hidden');
    if (errorDiv) errorDiv.classList.add('hidden');
    var formData = new FormData();
    formData.append('image_data', currentImageData);
    fetch('/ia/analyze', {
      method: 'POST',
      headers: { 'X-CSRF-Token': csrfToken || '' },
      body: formData
    })
    .then(function(response) { return response.json(); })
    .then(function(data) {
      loading.classList.add('hidden');
      if (data.error) {
        showError(data.error, data.necesita_config === true);
      } else {
        showResults(data);
      }
    })
    .catch(function(error) {
      loading.classList.add('hidden');
      showError('Error de conexión: ' + error.message, false);
    });
  }

  function showError(message, necesitaConfig) {
    if (!errorDiv) return;
    errorDiv.classList.remove('hidden');
    var errorMsg = document.getElementById('iaErrorMsg');
    if (errorMsg) {
      if (necesitaConfig) {
        errorMsg.innerHTML = message + '<br><br><a href="/config_ia" class="inline-block mt-2 text-[#B8860B] hover:underline font-medium">Ir a configurar API Key →</a>';
      } else {
        errorMsg.textContent = message;
      }
    }
  }

  function showResults(data) {
    if (!results) return;
    results.classList.remove('hidden');
    currentAnalysis = data;
    var confianza = data.confianza || 0;
    document.getElementById('iaConfianza').textContent = confianza + '%';
    document.getElementById('iaConfianzaBar').style.width = confianza + '%';
    var confianzaBar = document.getElementById('iaConfianzaBar');
    if (confianza >= 80) confianzaBar.className = 'bg-[#3D5E3D] h-2 rounded-full transition-all duration-500';
    else if (confianza >= 50) confianzaBar.className = 'bg-[#B8860B] h-2 rounded-full transition-all duration-500';
    else confianzaBar.className = 'bg-[#A63D2F] h-2 rounded-full transition-all duration-500';
    document.getElementById('iaDescripcion').value = data.descripcion || '';
    document.getElementById('iaTipoProducto').value = data.tipo_producto || '';
    document.getElementById('iaCategoriaSugerida').value = data.categoria_sugerida || '';
    document.getElementById('iaMarcaModelo').value = data.marca_modelo || '';
    var estadoSelect = document.getElementById('iaEstado');
    if (data.estado) {
      for (var i = 0; i < estadoSelect.options.length; i++) {
        if (estadoSelect.options[i].value === data.estado) {
          estadoSelect.selectedIndex = i;
          break;
        }
      }
    }
    var erroresDiv = document.getElementById('iaErrores');
    if (data.errores && data.errores.length > 0) {
      erroresDiv.classList.remove('hidden');
      erroresDiv.innerHTML = '<strong>Notas:</strong> ' + data.errores.join(', ');
    } else {
      erroresDiv.classList.add('hidden');
    }
  }

  function applyToForm() {
    if (!currentAnalysis) return;
    var descripcion = document.getElementById('iaDescripcion').value;
    var nombre = document.getElementById('iaMarcaModelo').value || document.getElementById('iaTipoProducto').value;
    var estado = document.getElementById('iaEstado').value;
    var categoriaSugerida = document.getElementById('iaCategoriaSugerida').value;
    var nombreInput = document.getElementById('producto_nombre') || document.querySelector('input[name="producto[nombre]"]');
    var descripcionInput = document.getElementById('descripcionField') || document.querySelector('textarea[name="producto[descripcion]"]');
    var estadoSelect = document.getElementById('producto_estado') || document.querySelector('select[name="producto[estado]"]');
    if (nombreInput && nombre) nombreInput.value = nombre;
    if (descripcionInput && descripcion) descripcionInput.value = descripcion;
    if (estadoSelect && estado) {
      for (var i = 0; i < estadoSelect.options.length; i++) {
        if (estadoSelect.options[i].value === estado) {
          estadoSelect.selectedIndex = i;
          break;
        }
      }
    }
    if (categoriaSugerida) {
      var categoriaSelect = document.getElementById('producto_categoria_id') || document.querySelector('select[name="producto[categoria_id]"]');
      if (categoriaSelect) {
        for (var j = 0; j < categoriaSelect.options.length; j++) {
          if (categoriaSelect.options[j].text.toLowerCase().includes(categoriaSugerida.toLowerCase())) {
            categoriaSelect.selectedIndex = j;
            break;
          }
        }
      }
    }
    closeModal();
  }

  function createNewProduct() {
    if (!currentAnalysis) return;
    var editModeInput = document.getElementById('formEditMode');
    var isEditMode = editModeInput && editModeInput.value === 'true';
    if (isEditMode) {
      alert('Ya estás editando un producto existente.');
      return;
    }
    var descripcion = document.getElementById('iaDescripcion').value;
    var nombre = document.getElementById('iaMarcaModelo').value || document.getElementById('iaTipoProducto').value;
    var estado = document.getElementById('iaEstado').value;
    var params = new URLSearchParams();
    if (nombre) params.set('nombre', nombre);
    if (descripcion) params.set('descripcion', descripcion);
    if (estado) params.set('estado', estado);
    params.set('from_ia', '1');
    if (currentImageData) {
      try {
        var imageKey = 'ia_image_' + Date.now();
        localStorage.setItem(imageKey, currentImageData);
        params.set('ia_image_key', imageKey);
      } catch (e) {
        if (currentImageData.length < 30000) params.set('ia_image_data', currentImageData);
      }
    }
    window.location.href = '/productos/new?' + params.toString();
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
    if (iaCameraInput) iaCameraInput.value = '';
  }

  if (btnClose) btnClose.addEventListener('click', closeModal);
  if (btnCancel) btnCancel.addEventListener('click', closeModal);
  if (btnAplicar) btnAplicar.addEventListener('click', applyToForm);
  if (btnCrearProducto) btnCrearProducto.addEventListener('click', createNewProduct);
  if (btnRetry) btnRetry.addEventListener('click', analyzeImage);

  if (modal) {
    modal.addEventListener('click', function(e) {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }
})();
</script>
  </body>
</html>