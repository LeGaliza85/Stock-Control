<!DOCTYPE html>
<html>
<head>
  <title>StockControl</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
< /head>
<body class="min-h-screen" style="background-color: var(--bg-cream); color: var(--text-primary); font-family: 'DM Sans', sans-serif;">
  <header style="border-bottom:1px solid #ddd; padding:12px 16px;">
    <div style="display:flex; align-items:center; justify-content:space-between;">
      <%= link_to root_path do %>
        <%= image_tag "logo.webp", alt: "StockControl", class: "w-8 h-8" %>
      <% end %>
    </div>
  </header>
  <main class="container mx-auto px-4 py-6">
    <%= yield %>
  </main>
</body>
</html>
