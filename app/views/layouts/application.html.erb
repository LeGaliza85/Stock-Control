<!DOCTYPE html>
<html>
<head>
  <title>StockControl</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="min-h-screen" style="background-color: var(--bg-cream); color: var(--text-primary); font-family: 'DM Sans', sans-serif;">
  <!-- Barra mínima: Logo + Hamburguesa (sin avatar) -->
  <nav class="sticky top-0 z-50 shadow-lg" style="background-color: var(--navbar-bg);">
    <div class="container mx-auto px-4 py-3 flex items-center justify-between">
      <%= link_to root_path, class: "hover:opacity-80 transition-opacity flex gap-2" do %>
        <%= image_tag "logo.webp", alt: "StockControl", class: "w-8 h-8" %>
        <span style="font-family: 'Playfair Display', serif; color: var(--accent);" class="text-xl font-bold tracking-tight">StockControl</span>
      <% end %>

      <!-- Hamburguesa para móvil -->
      <button class="md:hidden" id="mobileMenuBtn" aria-label="Open menu">☰</button>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-8">
    <%= yield %>
  </main>
</body>
</html>
