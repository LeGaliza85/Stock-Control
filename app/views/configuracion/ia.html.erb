<div class="max-w-2xl mx-auto">
  <div class="mb-8">
    <%= link_to productos_path, class: "inline-flex items-center gap-1 text-[#B8860B] hover:text-[#9A7209] text-sm font-medium transition-all duration-200" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"/></svg>
      Volver al inventario
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-[#E8E0D4] shadow-sm p-8">
    <h1 class="text-2xl font-bold text-[#2C1810] mb-6" style="font-family: 'Playfair Display', serif;">Configuración de IA</h1>

    <% if flash[:notice] %>
      <div class="mb-4 p-3 rounded-lg text-sm bg-[#E8F0E8] text-[#3D5E3D] border border-[#C4D9C4]">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert] %>
      <div class="mb-4 p-3 rounded-lg text-sm bg-[#F4DCDC] text-[#A63D2F] border border-[#E0B8B8]">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: ia_config_path, method: :patch, local: true, id: "iaConfigForm", data: { controller: "ia-config" } do |f| %>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-medium text-[#6B5744] mb-3">Servicio de IA para análisis de imágenes</label>
          <div class="space-y-3">
            <% @ia_services.each do |service| %>
              <label class="flex items-start gap-3 p-4 rounded-lg border-2 cursor-pointer transition-all ia-service-option <%= service[:id] == @current_service ? 'border-[#B8860B] bg-[#F5ECD7]/30' : 'border-[#E8E0D4]' %>" data-service="<%= service[:id] %>" data-ia-config-target="option">
                <%= f.radio_button :ia_service, service[:id], class: "mt-1 accent-[#B8860B]", data: { action: "change->ia-config#change" }, checked: service[:id] == @current_service %>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <span class="font-semibold text-[#2C1810]"><%= service[:name] %></span>
                  </div>
                  <div class="mt-2 flex flex-col gap-1">
                    <div class="flex items-center justify-between text-xs">
                      <span class="text-[#6B5744]">Hoy:</span>
                      <span class="font-medium text-[#2C1810]"><%= service[:used_today] %> / <%= number_with_delimiter(service[:limit_today]) %> <%= service[:label] %></span>
                    </div>
                    <div class="w-full bg-[#E8E0D4] rounded-full h-1.5">
                      <div class="bg-[#10B981] h-1.5 rounded-full" style="width: <%= service[:limit_today] > 0 ? (service[:used_today].to_f / service[:limit_today] * 100).round : 0 %>%"></div>
                    </div>
                    <div class="flex items-center justify-between text-xs mt-1">
                      <span class="text-[#6B5744]">Este mes:</span>
                      <span class="font-medium text-[#2C1810]"><%= service[:used_month] %> / <%= number_with_delimiter(service[:limit_month]) %> <%= service[:label] %></span>
                    </div>
                    <div class="w-full bg-[#E8E0D4] rounded-full h-1.5">
                      <div class="bg-[#059669] h-1.5 rounded-full" style="width: <%= service[:limit_month] > 0 ? (service[:used_month].to_f / service[:limit_month] * 100).round : 0 %>%"></div>
                    </div>
                  </div>
                  <p class="text-sm text-[#6B5744] mt-2">
                    <%= service[:description] %>
                  </p>
                </div>
              </label>
            <% end %>
          </div>
        </div>

        <div id="geminiModelSelect" data-ia-config-target="geminiSelect" class="<%= @current_service == 'gemini' ? '' : 'hidden' %>">
          <label class="block text-sm font-medium text-[#6B5744] mb-2">Modelo de Gemini</label>
          <%= f.select :gemini_model, 
              options_for_select(
                @gemini_models.map { |key, val| [val.is_a?(Hash) ? val[:name] : val, key] },
                @current_gemini_model
              ),
              {}, 
              class: "w-full rounded-lg border border-[#E8E0D4] bg-white text-[#2C1810] shadow-sm focus:border-[#B8860B] focus:ring-[#B8860B] focus:ring-1 text-sm" 
          %>
          <p class="text-xs text-[#6B5744] mt-1">Selecciona el modelo de Gemini que deseas usar</p>
        </div>

        <div class="pt-4">
          <%= f.submit "Guardar configuración", class: "w-full rounded-lg bg-[#B8860B] px-6 py-3 text-sm font-semibold text-white shadow-sm hover:bg-[#9A7209] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#B8860B] cursor-pointer transition-all duration-200" %>
        </div>
      </div>
    <% end %>
  </div>


</div>
